# Voxaura environment. Copy to .env and fill in.

# Neon Postgres connection string (or any Postgres URL)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# AssemblyAI API key — enables Voice Agent API (agents REST + realtime WS + temp tokens).
# https://assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# OpenAI API key — primary LLM for hidden state generation + post-call scoring.
# If out of credits, the app automatically falls back to Groq below.
OPENAI_API_KEY=

# Groq API key — FREE tier fallback (OpenAI-compatible). Get one at
# https://console.groq.com — no credit card needed. Used automatically when
# OpenAI is missing or fails (401/402/429), or pin it with LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: "openai" or "groq" to pin one provider. Default: OpenAI first, Groq fallback.
# LLM_PROVIDER=groq

# Absolute origin of this app; used to build webhook URLs recorded on scenario metadata.
APP_BASE_URL=http://localhost:3000

# Analysis model used for hidden state generation + scoring when using OpenAI.
LLM_MODEL=gpt-4o-mini

# Set to "1" during development to simulate scoring/scenario generation without
# calling any LLM or AssemblyAI at all.
AI_DEBUG=0

# Optional: allow the session client to bind to an inline-configured agent
# (system prompt sent to the browser) instead of a stored agent. "1" = allowed.
ALLOW_INLINE_AGENT=0
