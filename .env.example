# Voxaura environment. Copy to .env and fill in: cp .env.example .env
#
# Required to run:      DATABASE_URL, ASSEMBLYAI_API_KEY, and one LLM key
#                       (OPENAI_API_KEY and/or GROQ_API_KEY).
# Required to typecheck/test/build: DATABASE_URL (see README).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon Postgres connection string (or any Postgres URL). Create the tables with
# `npm run db:push` and add the demo scenarios with `npm run seed`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---------------------------------------------------------------------------
# Voice (AssemblyAI Voice Agent API)
# ---------------------------------------------------------------------------
# https://assemblyai.com/dashboard — powers the realtime voice agent (STT → LLM
# → TTS on one WebSocket), the stored-agent API, and the temp tokens the browser
# uses to open the socket.
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# Language models
# ---------------------------------------------------------------------------
# OpenAI is primary (hidden-state generation + post-call scoring).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Groq is the free-tier fallback (OpenAI-compatible). Used automatically when
# OpenAI is missing or fails with 401/402/429. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Pin a single provider instead of the OpenAI → Groq chain: "openai" or "groq".
# LLM_PROVIDER=groq

# ---------------------------------------------------------------------------
# Agent binding mode — where the opponent's system prompt lives
# ---------------------------------------------------------------------------
# auto    (default) Inline session config. AssemblyAI agents created from
#                   serverless infrastructure (Vercel) are not resolvable from a
#                   browser IP, which produces a 1008 close, so inline is the
#                   reliable path and is therefore the default rather than a
#                   silent fallback.
# inline            Force inline. The prompt is fetched by the session page from
#                   an owner-checked endpoint immediately before the call — it is
#                   NEVER placed in a URL.
# stored            Always bind a stored agent by opaque id; the prompt never
#                   leaves the server. Use this when stored agents resolve for
#                   your deployment.
# AGENT_MODE=auto

# Set to "0" to explicitly forbid the inline path. This also disables the only
# endpoint that can serve the prompt to a browser, so an attempt that cannot get
# a stored agent fails with a clear 503 instead of silently going inline.
# Leave it unset (or set "1") on Vercel, where inline is required.
# ALLOW_INLINE_AGENT=1

# ---------------------------------------------------------------------------
# Development / debugging
# ---------------------------------------------------------------------------
# Absolute origin of this app. Used to build any self-referencing URL.
APP_BASE_URL=http://localhost:3000

# "1" simulates scoring and scenario generation without calling any LLM at all
# (the live call still needs ASSEMBLYAI_API_KEY). Never enable in production.
AI_DEBUG=0
